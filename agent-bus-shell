#!/usr/bin/env python3
"""agent-bus-shell: forced SSH command for the `bus` user.

Binds one SSH key to one agent identity: the key's authorized_keys entry
names the agent, and every command the key runs is enforced as that agent.
Only `agent-bus` invocations are permitted, against the fixed bus directory.

The client's command arrives in SSH_ORIGINAL_COMMAND as a shell-quoted
string (the remote wrapper builds it with shlex.join). It is parsed with
shlex.split -- quoting is honored but nothing is executed, so shell
metacharacters in message bodies ($, ;, backticks, ...) stay literal
arguments and can never break out into a shell.

Install: /usr/local/bin/agent-bus-shell, referenced from ~bus/.ssh/authorized_keys as:
  restrict,command="/usr/local/bin/agent-bus-shell omni" <omni's public key>

Local shell users on the server are unrestricted; remote callers cannot use
--force, purge, init, or recover. A missing or unknown identity never dispatches.
"""
import os
import shlex
import sys

AGENTS = ("omni", "openclaw", "codex", "claude")
BUS_BIN = os.environ.get("AGENT_BUS_BIN", "/usr/local/bin/agent-bus")
BUS_DIR = os.environ.get("AGENT_BUS_DIR", "/srv/agent-bus")


def main():
    rid = sys.argv[1] if len(sys.argv) > 1 else ""
    if rid not in AGENTS:
        sys.exit("agent-bus-shell: missing or unknown identity")
    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    try:
        argv = shlex.split(raw)
    except ValueError as e:
        sys.exit(f"agent-bus-shell: bad command: {e}")
    if not argv or argv[0] != "agent-bus":
        sys.exit("only agent-bus commands are allowed")
    env = dict(os.environ, AGENT_BUS_REMOTE_ID=rid)
    os.execvpe(BUS_BIN, [BUS_BIN, "--bus", BUS_DIR] + argv[1:], env)


if __name__ == "__main__":
    main()
