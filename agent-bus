#!/usr/bin/env python3
"""agent-bus: minimal inter-agent message bus. stdlib only.

All state lives under --bus DIR. Every write is temp-file + atomic rename.
Task files are immutable once created; state lives in the directory they sit
in (open/claimed/done) plus atomic sidecar files. See BUS_PROTOCOL.md.

Security model:
  - Message/task IDs are validated against a strict pattern and contained
    under their expected directory (no path traversal).
  - When AGENT_BUS_REMOTE_ID is set (SSH forced command), the caller is bound
    to that identity: --from and positional agent args must match it,
    --force is denied, and purge/init are server-admin only.
"""
import argparse
import datetime
import json
import os
import re
import secrets
import shutil
import sys

AGENTS = ("omni", "openclaw", "codex", "claude")
MSG_TYPES = ("message", "question", "task-request", "task-update", "handoff", "broadcast")
ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")
TASK_STATES = ("open", "claimed", "done")
# Shared group for the bus user and local agent users. Overridable for tests.
BUS_GROUP = os.environ.get("AGENT_BUS_GROUP", "agent-bus")


def remote_id():
    """Identity bound by the SSH forced command, or None for local use."""
    return os.environ.get("AGENT_BUS_REMOTE_ID")


def check_remote_identity():
    """Fail closed: presence of AGENT_BUS_REMOTE_ID means remote mode, and
    the value must be a known agent. An empty or unknown value is never
    treated as unrestricted local access."""
    if "AGENT_BUS_REMOTE_ID" in os.environ:
        rid = os.environ["AGENT_BUS_REMOTE_ID"]
        if rid not in AGENTS:
            sys.exit(f"unknown remote identity: {rid!r}")


def utcnow():
    return datetime.datetime.now(datetime.timezone.utc)


def ts_iso(dt=None):
    return (dt or utcnow()).strftime("%Y-%m-%dT%H:%M:%SZ")


def new_id(prefix=""):
    return f"{prefix}{utcnow().strftime('%Y%m%dT%H%M%SZ')}-{secrets.token_hex(3)}"


def valid_id(s, what="id"):
    if not isinstance(s, str) or not ID_RE.fullmatch(s):
        sys.exit(f"invalid {what}: {s!r}")
    return s


def contained(path, base):
    """True if path resolves inside base (defense in depth after valid_id)."""
    rp = os.path.realpath(path)
    rb = os.path.realpath(base)
    return rp == rb or rp.startswith(rb + os.sep)


def require_self(agent, what="agent"):
    rid = remote_id()
    if rid and agent != rid:
        sys.exit(f"remote identity is '{rid}': not authorized as '{agent}' ({what})")


def require_local(what):
    if remote_id():
        sys.exit(f"{what} is a server-admin operation, not available remotely")


def bus_dir(args):
    d = os.path.abspath(args.bus)
    if not os.path.isdir(d):
        sys.exit(f"bus dir not found: {d} (run `init` first)")
    return d


def atomic_write(path, obj):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2, ensure_ascii=False)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def load_record(path):
    """Load one JSON record; warn and return None instead of crashing."""
    try:
        with open(path, encoding="utf-8") as f:
            obj = json.load(f)
    except (OSError, ValueError) as e:
        print(f"warning: skipping unreadable record {path}: {e}", file=sys.stderr)
        return None
    if not isinstance(obj, dict):
        print(f"warning: skipping non-object record {path}", file=sys.stderr)
        return None
    return obj


def inbox_file(d, agent, mid, archived=False):
    valid_id(mid, "message id")
    base = os.path.join(d, "inbox", agent, "archive" if archived else "")
    p = os.path.join(base, mid + ".json")
    if not contained(p, os.path.join(d, "inbox", agent)):
        sys.exit("path escape blocked")
    return p


def task_file(d, state, tid):
    valid_id(tid, "task id")
    base = os.path.join(d, "tasks", state)
    p = os.path.join(base, tid + ".json")
    if not contained(p, base):
        sys.exit("path escape blocked")
    return p


def sidecar_path(d, state, tid, kind):
    """kind is 'claim' or 'finish'; sidecars are written atomically."""
    valid_id(tid, "task id")
    base = os.path.join(d, "tasks", state)
    p = os.path.join(base, f"{tid}.{kind}.json")
    if not contained(p, base):
        sys.exit("path escape blocked")
    return p


def read_sidecar(d, state, tid, kind):
    p = sidecar_path(d, state, tid, kind)
    if not os.path.exists(p):
        return {}
    return load_record(p) or {}


def claim_owner(d, tid):
    """Return the claiming agent, or None if the claim sidecar is missing,
    corrupt, or names an unknown agent (orphaned claim)."""
    sc = read_sidecar(d, "claimed", tid, "claim")
    by = sc.get("claimed_by")
    return by if by in AGENTS else None


def find_orphans(d):
    """Task ids sitting in claimed/ without valid claim metadata."""
    orphans = []
    cdir = os.path.join(d, "tasks", "claimed")
    for fn in sorted(os.listdir(cdir)):
        if not fn.endswith(".json") or fn.endswith(".claim.json"):
            continue
        tid = fn[:-5]
        if claim_owner(d, tid) is None:
            orphans.append(tid)
    return orphans


def body_text(args):
    if args.body_file:
        with open(args.body_file, encoding="utf-8") as f:
            return f.read()
    return args.body or ""


def cmd_init(args):
    require_local("init")
    d = os.path.abspath(args.bus)
    subdirs = (["inbox/" + a for a in AGENTS] + ["inbox/" + a + "/archive" for a in AGENTS]
               + ["tasks/open", "tasks/claimed", "tasks/done", "log"])
    for sub in subdirs:
        os.makedirs(os.path.join(d, sub), exist_ok=True)
    reg = os.path.join(d, "registry.json")
    if not os.path.exists(reg):
        seed = os.path.join(os.path.dirname(os.path.abspath(__file__)), "registry.seed.json")
        if os.path.exists(seed):
            with open(seed, encoding="utf-8") as f:
                atomic_write(reg, json.load(f))
        else:
            atomic_write(reg, {"agents": {a: {"desc": "", "cadence": ""} for a in AGENTS}})
    apply_bus_perms(d)
    print(f"bus ready at {d}")


def _secure_dir(p):
    try:
        shutil.chown(p, group=BUS_GROUP)
    except (LookupError, PermissionError, OSError) as e:
        print(f"warning: cannot set group on {p}: {e}", file=sys.stderr)
    try:
        os.chmod(p, 0o2770)
    except OSError as e:
        print(f"warning: cannot chmod {p}: {e}", file=sys.stderr)


def apply_bus_perms(d):
    """Idempotent permission setup: group BUS_GROUP owns everything,
    directories are 2770 (setgid, group-only), registry is 660."""
    _secure_dir(d)
    try:
        for root, dirs, _ in os.walk(d):
            for name in dirs:
                _secure_dir(os.path.join(root, name))
    except OSError as e:
        print(f"warning: permission walk failed: {e}", file=sys.stderr)
    reg = os.path.join(d, "registry.json")
    if os.path.exists(reg):
        try:
            shutil.chown(reg, group=BUS_GROUP)
            os.chmod(reg, 0o660)
        except (LookupError, PermissionError, OSError) as e:
            print(f"warning: cannot secure {reg}: {e}", file=sys.stderr)


def cmd_send(args):
    d = bus_dir(args)
    require_self(args.sender, "--from")
    recipients = AGENTS if args.to == "*" else [args.to]
    if args.to != "*" and args.to not in AGENTS:
        sys.exit(f"unknown agent: {args.to} (known: {', '.join(AGENTS)})")
    mtype = "broadcast" if args.to == "*" else args.type
    if mtype not in MSG_TYPES:
        sys.exit(f"unknown type: {mtype}")
    body = body_text(args)
    now = utcnow()
    exp = now + datetime.timedelta(seconds=args.ttl_secs)
    sent = []
    for to in recipients:
        msg = {
            "id": new_id(),
            "ts": ts_iso(now),
            "from": args.sender,
            "to": to,
            "type": mtype,
            "subject": args.subject,
            "body": body,
            "thread": args.thread,
            "expires_at": ts_iso(exp),
        }
        atomic_write(inbox_file(d, to, msg["id"]), msg)
        sent.append(msg["id"])
    print(json.dumps({"sent": sent, "to": list(recipients)}))


def list_inbox(d, agent, include_expired=False):
    require_self(agent, "inbox")
    now = ts_iso()
    out = []
    ibox = os.path.join(d, "inbox", agent)
    for fn in sorted(os.listdir(ibox)):
        if not fn.endswith(".json"):
            continue
        msg = load_record(os.path.join(ibox, fn))
        if msg is None:
            continue
        expired = msg.get("expires_at", "") < now
        if expired and not include_expired:
            continue
        out.append({
            "id": msg.get("id", fn[:-5]), "ts": msg.get("ts", ""),
            "from": msg.get("from", ""), "type": msg.get("type", ""),
            "subject": msg.get("subject", ""), "thread": msg.get("thread"),
            "expired": expired,
        })
    return out


def cmd_inbox(args):
    d = bus_dir(args)
    msgs = list_inbox(d, args.agent, include_expired=args.all)
    if args.json:
        print(json.dumps(msgs, indent=2))
    elif not msgs:
        print("(empty)")
    else:
        for m in msgs:
            flag = " [expired]" if m["expired"] else ""
            print(f"{m['id']}  {m['ts']}  from={m['from']}  [{m['type']}]  {m['subject']}{flag}")


def cmd_read(args):
    d = bus_dir(args)
    require_self(args.agent, "read")
    p = inbox_file(d, args.agent, args.msgid)
    if not os.path.exists(p):
        p = inbox_file(d, args.agent, args.msgid, archived=True)
    if not os.path.exists(p):
        sys.exit(f"message not found: {args.msgid}")
    msg = load_record(p)
    if msg is None:
        sys.exit(f"message unreadable: {args.msgid}")
    print(json.dumps(msg, indent=2, ensure_ascii=False))


def cmd_ack(args):
    d = bus_dir(args)
    require_self(args.agent, "ack")
    acked = []
    for mid in args.msgids:
        src = inbox_file(d, args.agent, mid)
        if not os.path.exists(src):
            print(f"skip (not found): {mid}", file=sys.stderr)
            continue
        os.replace(src, inbox_file(d, args.agent, mid, archived=True))
        acked.append(mid)
    print(json.dumps({"acked": acked}))


def cmd_propose(args):
    d = bus_dir(args)
    require_self(args.sender, "--from")
    task = {
        "id": new_id("task-"),
        "ts": ts_iso(),
        "proposed_by": args.sender,
        "subject": args.subject,
        "body": body_text(args),
    }
    atomic_write(task_file(d, "open", task["id"]), task)
    print(json.dumps({"proposed": task["id"]}))


def find_task(d, tid):
    """Return (state, path) for a task id, or (None, None)."""
    for state in TASK_STATES:
        p = task_file(d, state, tid)
        if os.path.exists(p):
            return state, p
    return None, None


def cmd_claim(args):
    d = bus_dir(args)
    require_self(args.agent, "claim")
    tid = valid_id(args.taskid, "task id")
    src = task_file(d, "open", tid)
    dst = task_file(d, "claimed", tid)
    state, _ = find_task(d, tid)
    if state != "open":
        if state == "claimed":
            by = read_sidecar(d, "claimed", tid, "claim").get("claimed_by")
            sys.exit(f"already claimed by {by or 'unknown'}")
        sys.exit(f"task not found: {tid}")
    if load_record(src) is None:
        sys.exit(f"task unreadable, not claiming: {tid}")
    # The rename is the atomic claim: exactly one racing claimant succeeds.
    try:
        os.replace(src, dst)
    except FileNotFoundError:
        by = read_sidecar(d, "claimed", tid, "claim").get("claimed_by")
        sys.exit(f"already claimed by {by or 'unknown'}")
    # Sidecar is written only by the winner, after winning. A crash here
    # leaves the task correctly in claimed/ with unknown claimer — degraded
    # metadata, never contradictory state.
    atomic_write(sidecar_path(d, "claimed", tid, "claim"),
                 {"claimed_by": args.agent, "claimed_at": ts_iso()})
    print(json.dumps({"claimed": tid, "by": args.agent}))


def cmd_release(args):
    d = bus_dir(args)
    require_self(args.agent, "release")
    if args.force and remote_id():
        sys.exit("--force is not available remotely")
    tid = valid_id(args.taskid, "task id")
    src = task_file(d, "claimed", tid)
    if load_record(src) is None:
        sys.exit(f"task not claimed: {tid}")
    owner = claim_owner(d, tid)
    if owner is None:
        sys.exit(f"orphaned claim (missing or invalid claim metadata); "
                 f"a server admin must run `recover`")
    if owner != args.agent and not args.force:
        sys.exit(f"claimed by {owner}; use --force to override")
    os.replace(src, task_file(d, "open", tid))
    try:
        os.unlink(sidecar_path(d, "claimed", tid, "claim"))
    except FileNotFoundError:
        pass
    print(json.dumps({"released": tid}))


def cmd_finish(args):
    d = bus_dir(args)
    require_self(args.agent, "finish")
    if args.force and remote_id():
        sys.exit("--force is not available remotely")
    tid = valid_id(args.taskid, "task id")
    src = task_file(d, "claimed", tid)
    if load_record(src) is None:
        sys.exit(f"task not claimed: {tid}")
    owner = claim_owner(d, tid)
    if owner is None:
        sys.exit(f"orphaned claim (missing or invalid claim metadata); "
                 f"a server admin must run `recover`")
    if owner != args.agent and not args.force:
        sys.exit(f"claimed by {owner}; use --force to override")
    os.replace(src, task_file(d, "done", tid))
    try:
        os.unlink(sidecar_path(d, "claimed", tid, "claim"))
    except FileNotFoundError:
        pass
    atomic_write(sidecar_path(d, "done", tid, "finish"),
                 {"finished_by": args.agent, "finished_at": ts_iso(),
                  "finish_note": args.note or ""})
    print(json.dumps({"finished": tid}))


def cmd_recover(args):
    require_local("recover")
    d = bus_dir(args)
    orphans = find_orphans(d)
    if args.list:
        if args.json:
            print(json.dumps({"orphans": orphans}, indent=2))
        elif not orphans:
            print("(no orphaned claims)")
        else:
            for tid in orphans:
                print(tid)
        return
    tid = valid_id(args.taskid, "task id")
    if tid not in orphans:
        sys.exit(f"not an orphaned claim: {tid}")
    now = ts_iso()
    if args.release:
        os.replace(task_file(d, "claimed", tid), task_file(d, "open", tid))
        _log_event(d, "admin", f"recover: released orphaned claim {tid} to open")
        print(json.dumps({"recovered": tid, "action": "release"}))
    else:
        os.replace(task_file(d, "claimed", tid), task_file(d, "done", tid))
        atomic_write(sidecar_path(d, "done", tid, "finish"),
                     {"finished_by": "admin", "finished_at": now,
                      "finish_note": args.note or "",
                      "recovered_by": "admin", "recovered_at": now})
        _log_event(d, "admin", f"recover: finished orphaned claim {tid}")
        print(json.dumps({"recovered": tid, "action": "finish"}))


def task_view(d, state, tid, task):
    view = {
        "id": tid, "state": state,
        "subject": task.get("subject", ""), "proposed_by": task.get("proposed_by", ""),
        "claimed_by": None, "claimed_at": None, "orphan": False,
        "finished_by": None, "finished_at": None, "finish_note": None,
    }
    if state == "claimed":
        by = claim_owner(d, tid)
        sc = read_sidecar(d, state, tid, "claim")
        view["claimed_by"] = by
        view["claimed_at"] = sc.get("claimed_at")
        view["orphan"] = by is None
    elif state == "done":
        sc = read_sidecar(d, state, tid, "finish")
        view["finished_by"] = sc.get("finished_by")
        view["finished_at"] = sc.get("finished_at")
        view["finish_note"] = sc.get("finish_note")
    return view


def cmd_tasks(args):
    d = bus_dir(args)
    states = [args.state] if args.state != "all" else list(TASK_STATES)
    out = []
    for state in states:
        tdir = os.path.join(d, "tasks", state)
        for fn in sorted(os.listdir(tdir)):
            if not fn.endswith(".json") or fn.endswith(".claim.json") or fn.endswith(".finish.json"):
                continue
            tid = fn[:-5]
            task = load_record(os.path.join(tdir, fn))
            if task is None:
                continue
            out.append(task_view(d, state, tid, task))
    if args.json:
        print(json.dumps(out, indent=2))
    elif not out:
        print("(no tasks)")
    else:
        for t in out:
            extra = f" claimed_by={t['claimed_by']}" if t["claimed_by"] else ""
            print(f"{t['id']}  [{t['state']}]  {t['subject']}  (by {t['proposed_by']}{extra})")


def cmd_registry(args):
    d = bus_dir(args)
    reg = load_record(os.path.join(d, "registry.json"))
    if reg is None:
        sys.exit("registry unreadable")
    if args.json:
        print(json.dumps(reg, indent=2))
    else:
        for name, info in reg.get("agents", {}).items():
            print(f"{name}: {info.get('desc', '')} [polls: {info.get('cadence', '')}]")


def _log_event(d, who, event):
    line = json.dumps({"ts": ts_iso(), "from": who, "event": event},
                      ensure_ascii=False)
    with open(os.path.join(d, "log", utcnow().strftime("%Y-%m-%d") + ".jsonl"),
              "a", encoding="utf-8") as f:
        f.write(line + "\n")


def cmd_log(args):
    d = bus_dir(args)
    require_self(args.sender, "--from")
    _log_event(d, args.sender, args.event)
    print("logged")


def cmd_purge(args):
    require_local("purge")
    d = bus_dir(args)
    cutoff = ts_iso(utcnow() - datetime.timedelta(days=args.grace_days))
    removed = []
    for agent in AGENTS:
        ibox = os.path.join(d, "inbox", agent)
        for fn in sorted(os.listdir(ibox)):
            if not fn.endswith(".json"):
                continue
            p = os.path.join(ibox, fn)
            msg = load_record(p)
            if msg is None:
                continue
            if msg.get("expires_at", "") < cutoff:
                removed.append(f"{agent}/{fn[:-5]}")
                if not args.dry_run:
                    os.unlink(p)
    print(json.dumps({"purged": sorted(removed), "dry_run": args.dry_run}))


def add_common_body(p):
    g = p.add_mutually_exclusive_group()
    g.add_argument("--body", default="")
    g.add_argument("--body-file")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="agent-bus")
    ap.add_argument("--bus", default="/srv/agent-bus")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init")

    p = sub.add_parser("send")
    p.add_argument("--from", dest="sender", required=True, choices=AGENTS)
    p.add_argument("--to", required=True)
    p.add_argument("--type", default="message")
    p.add_argument("--subject", required=True)
    p.add_argument("--thread", default=None)
    p.add_argument("--ttl-secs", type=int, default=86400)
    add_common_body(p)

    p = sub.add_parser("broadcast")
    p.add_argument("--from", dest="sender", required=True, choices=AGENTS)
    p.add_argument("--subject", required=True)
    p.add_argument("--thread", default=None)
    p.add_argument("--ttl-secs", type=int, default=86400)
    p.set_defaults(to="*")
    add_common_body(p)

    p = sub.add_parser("inbox")
    p.add_argument("agent", choices=AGENTS)
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("read")
    p.add_argument("agent", choices=AGENTS)
    p.add_argument("msgid")

    p = sub.add_parser("ack")
    p.add_argument("agent", choices=AGENTS)
    p.add_argument("msgids", nargs="+")

    p = sub.add_parser("propose")
    p.add_argument("--from", dest="sender", required=True, choices=AGENTS)
    p.add_argument("--subject", required=True)
    add_common_body(p)

    p = sub.add_parser("claim")
    p.add_argument("agent", choices=AGENTS)
    p.add_argument("taskid")

    p = sub.add_parser("release")
    p.add_argument("agent", choices=AGENTS)
    p.add_argument("taskid")
    p.add_argument("--force", action="store_true")

    p = sub.add_parser("finish")
    p.add_argument("agent", choices=AGENTS)
    p.add_argument("taskid")
    p.add_argument("--note", default="")
    p.add_argument("--force", action="store_true")

    p = sub.add_parser("tasks")
    p.add_argument("--state", default="all", choices=["all", "open", "claimed", "done"])
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("registry")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("log")
    p.add_argument("--from", dest="sender", required=True, choices=AGENTS)
    p.add_argument("--event", required=True)

    p = sub.add_parser("purge")
    p.add_argument("--grace-days", type=int, default=7,
                   help="only purge messages expired longer ago than this")
    p.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("recover")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--list", action="store_true")
    g.add_argument("--release", action="store_true")
    g.add_argument("--finish", action="store_true")
    p.add_argument("taskid", nargs="?")
    p.add_argument("--note", default="")
    p.add_argument("--json", action="store_true")

    args = ap.parse_args(argv)
    # Cooperative umask: everything the CLI creates is group-writable and
    # invisible to unrelated users, regardless of the caller's umask.
    os.umask(0o007)
    # Fail closed on remote identity before dispatching anything.
    check_remote_identity()
    {"init": cmd_init, "send": cmd_send, "broadcast": cmd_send, "inbox": cmd_inbox,
     "read": cmd_read, "ack": cmd_ack, "propose": cmd_propose, "claim": cmd_claim,
     "release": cmd_release, "finish": cmd_finish, "tasks": cmd_tasks,
     "registry": cmd_registry, "log": cmd_log, "purge": cmd_purge,
     "recover": cmd_recover}[args.cmd](args)


if __name__ == "__main__":
    main()
